# Claude Code telemetry settings for the skill-usage-ranker.
# Org rollout: put these under "env" in managed settings. Local testing: `set -a; source deploy/claude-telemetry.env; set +a`
CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Needed so custom skill names are not redacted to "custom_skill" on skill_activated.
# Also logs Bash commands / tool input — strip them in the collector (see docs/telemetry-mapping.md).
OTEL_LOG_TOOL_DETAILS=1
# Team dimensions (set per team via managed settings)
OTEL_RESOURCE_ATTRIBUTES=department=engineering,team.id=payments
